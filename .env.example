# Источник данных: mock (MSW + фикстуры) | rest (реальный бекенд по openapi.yaml) | strapi (пример CMS-адаптера, этап 5)
VITE_DATA_SOURCE=mock
# Базовый URL REST API (для rest). В mock-режиме запросы перехватывает MSW по /api.
VITE_API_URL=/api
# Базовый URL Strapi (для strapi)
VITE_STRAPI_URL=http://localhost:1337
